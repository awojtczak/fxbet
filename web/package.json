{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:pages": "npm run wasm && tsc -b && vite build --mode pages --outDir dist-pages && cp dist-pages/index.html dist-pages/404.html",
    "dev:pages": "npm run wasm && vite --mode pages",
    "wasm": "wasm-pack build ../wasm --target web --release --out-dir pkg"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
